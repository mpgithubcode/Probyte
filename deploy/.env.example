# Optional settings for the Docker Hub setup (deploy/docker-compose.yml). Copy to .env next to it; everything has a default.

# Web address port on this machine
PROBYTE_PORT=8080
# Your time zone (for all-day dates and calendar times)
TZ=UTC
# The address people use, e.g. https://probyte.example.com (for AI assistants, OAuth and phone setup; default: from the request)
# PUBLIC_URL=
# false once everyone has an account (the first account can always be made)
# ALLOW_SIGNUP=true
# Hours between automatic backups (0 = off) and how many to keep
# BACKUP_INTERVAL=24
# BACKUP_KEEP=14
# Largest upload to a files table, in MB
# FILES_MAX_UPLOAD_MB=2048
# Stay on one version instead of the newest
# PROBYTE_VERSION=0.2.0
