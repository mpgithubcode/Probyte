# Copy to .env and adjust.
POSTGRES_PASSWORD=change-me
DEFAULT_TZ=America/New_York
# Address phones use for CalDAV. Probyte passes calendar traffic through, so this can be Probyte's own public URL.
RADICALE_PUBLIC_URL=https://probyte.example.com/
# Set to false once everyone has an account
ALLOW_SIGNUP=true
PROBYTE_PORT=8080
RADICALE_PORT=5232
# Docker Hub images (deploy/docker-compose.yml): a version to stay on instead of the newest
# PROBYTE_VERSION=0.1.0
