# Copy to .env and adjust.
POSTGRES_PASSWORD=change-me
DEFAULT_TZ=America/New_York
# Probyte's public address (phones use it for calendars and contacts too: it's the CalDAV/CardDAV server)
PUBLIC_URL=https://probyte.example.com
# Set to false once everyone has an account
ALLOW_SIGNUP=true
PROBYTE_PORT=8080
# (This file is for the from-source setup. The Docker Hub setup needs no settings; its optional ones are in deploy/.env.example.)
